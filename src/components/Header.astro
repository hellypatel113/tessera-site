---
import { link } from "../lib/link";
import Logo from "./Logo.astro";
import { NAV, SITE } from "../data/site";

const path = Astro.url.pathname;
---
<header class="header">
  <div class="container header__inner">
    <Logo />
    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-menu>
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={link(item.href)} aria-current={path === link(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="btn btn--primary" href={SITE.installUrl}>Install free</a>
    </nav>
  </div>
</header>
