---
import { link } from "../lib/link";
/** The mosaic mark: four tiles in the brand spectrum. */
---
<a href={link("/")} class="logo" aria-label="Tessera home">
  <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true">
    <rect x="1" y="1" width="12" height="12" rx="3.5" fill="#7C3AED" />
    <rect x="15" y="1" width="12" height="12" rx="3.5" fill="#EC4899" />
    <rect x="1" y="15" width="12" height="12" rx="3.5" fill="#14B8A6" />
    <rect x="15" y="15" width="12" height="12" rx="6" fill="#F59E0B" />
  </svg>
  <span>Tessera</span>
</a>
