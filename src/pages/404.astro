---
import { link } from "../lib/link";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found">
  <section class="section center">
    <div class="container">
      <p class="display gradient-text">404</p>
      <h1 class="h2" style="margin-top:12px">This page took a different route.</h1>
      <p class="lead" style="margin:16px auto 28px">The page you're looking for doesn't exist or has moved.</p>
      <div class="btn-row"><a class="btn btn--primary" href={link("/")}>Go home</a><a class="btn btn--ghost" href={link("/features/")}>Browse features <span class="arrow">›</span></a></div>
    </div>
  </section>
</Layout>
